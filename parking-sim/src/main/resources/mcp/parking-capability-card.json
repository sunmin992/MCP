    "environmentMatchKeys": [
      {"key": "road-congestion", "matchKeys": ["혼잡", "교통", "도로 혼잡", "정체"]},
      {"key": "time-of-day-demand", "matchKeys": ["주말", "평일", "오전", "오후", "저녁", "야간", "점심", "출근", "퇴근", "시간대", "피크", "첨두"],
       "model": "이용자 유형별 도착 시각 분포(userMix)로 시간대 수요를 만들고 hourlyOccupancy 로 시간대별 점유를 본다. 평일 · 주말 수요를 따로 두지 않으므로 주말은 이용자 구성 · 하루 도착 대수로 표현한다"},
      {"key": "guidance", "matchKeys": ["실시간", "안내판", "주차 안내", "앱"]},
