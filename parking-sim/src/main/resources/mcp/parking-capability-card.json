    "environment": ["road-congestion", "time-of-day-demand", "guidance", "pricing", "resident-priority"],
    "answerableQuestions": ["search-time", "give-up", "occupancy", "pricing-effect", "guidance-effect", "resident-priority", "lot-count", "congestion-effect"],
    "scenarioTypes": ["guidance-compare", "pricing-compare", "capacity-sweep", "demand-sweep", "user-mix"],
    "tools": [
      {"name": "get_templates", "what": "서브태스크 템플릿", "status": "OK"},
      {"name": "plan_subtasks", "what": "생성 조건 평가", "status": "OK"},
      {"name": "validate_answers", "what": "답변 계약 대조", "status": "OK"},
      {"name": "build_scenario", "what": "실행 설정 N벌 생성 · 검증", "status": "OK"},
      {"name": "get_scenario_status", "what": "확인 상태 · 토큰 읽기", "status": "OK"},
