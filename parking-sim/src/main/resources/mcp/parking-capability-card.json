      {"key": "resident-priority", "matchKeys": ["거주자 우선", "거주자 구획", "거주자 전용"]}
    ],
    "objectiveMatchKeys": [
      {"key": "search-time", "label": "주차 탐색 시간", "matchKeys": ["찾는 시간", "탐색", "배회", "주차 찾", "주차장 찾", "자리 찾"]},
      {"key": "give-up", "label": "주차 포기 차량", "matchKeys": ["포기", "못 대", "주차 못", "돌아가"]},
      {"key": "occupancy", "label": "주차장 혼잡도 · 점유율", "matchKeys": ["혼잡도", "점유율", "만차", "빈자리", "얼마나 차"]},
      {"key": "pricing-effect", "label": "요금 정책 효과", "matchKeys": ["요금", "할증", "차등", "유료화", "무료"]},
      {"key": "guidance-effect", "label": "안내 방식 효과", "matchKeys": ["안내", "실시간 앱", "안내판", "앱"]},
      {"key": "resident-priority", "label": "거주자 우선 구획 효과", "matchKeys": ["거주자 우선", "거주자 구획"]},
      {"key": "lot-count", "label": "주차장 수 · 면수", "matchKeys": ["몇 곳", "주차장 수", "면수", "증설", "더 지으", "한 곳 더"]}
    ]
  },
