import pandas as pd
import numpy as np
from devs import Devs, Waste

# 시뮬레이션 모델 개요
def create_model():
    # 거주민 100명, 4개 건물, 건물당 25명
    num_residents = 100
    num_buildings = 4
    residents_per_building = 25
    
    # 직업: 생산직(일용직, 07:22 출발), 학생(08:58), 전업주부(14:00)
    job_types = ['production', 'student', 'homemaker']
    
    # 건물당 30kg 임시 수거통, 수거 차량이 매일 지정 시각에 전체 수거
    capacity_per_building = 30
    
    # 수거통 적재율이 임계치(기본 80%) 이상일 때 배출하면 민원 발생으로 집계
    threshold = 0.8
    
    return num_residents, num_buildings, residents_per_building, job_types, capacity_per_building, threshold

# 시뮬레이션 실행
def run_simulation(num_residents, num_buildings, residents_per_building, job_types, capacity_per_building, threshold):
    # 시뮬레이션 기간(일), 기본 30
    days = 30
    
    # 반복 횟수, 기본 30
    seeds = 30
    
    # 출발 시각 표준편차(분), 기본 30
    leave_sigma = 30.0
    
    # 일일 쓰레기 표준편차(kg), 기본 0.3
    waste_sigma = 0.3
    
    # 수거통 용량(kg), 기본 30
    collection_time = "12:00"
    
    model = Devs(
        num_residents=num_residents,
        num_buildings=num_buildings,
        residents_per_building=residents_per_building,
        job_types=job_types,
        capacity_per_building=capacity_per_building,
        threshold=threshold,
        days=days,
        seeds=seeds,
        leave_sigma=leave_sigma,
        waste_sigma=waste_sigma,
        collection_time=collection_time
    )
    
    # 시뮬레이션 실행
    results = model.run()
    
    return results

# JSON 블록
def create_json(results):
    json_data = {
        "action": "RUN_SIMULATION",
        "params": {
            "collectionTime": results["collection_time"],
            "days": results["days"],
            "seeds": results["seeds"],
            "leaveSigma": results["leave_sigma"],
            "wasteSigma": results["waste_sigma"],
            "threshold": results["threshold"],
            "capacity": results["capacity"]
        }
    }
    
    return json_data

# 시뮬레이션 실행
num_residents, num_buildings, residents_per_building, job_types, capacity_per_building, threshold = create_model()
results = run_simulation(num_residents, num_buildings, residents_per_building, job_types, capacity_per_building, threshold)
json_data = create_json(results)

print(json_data)
```

