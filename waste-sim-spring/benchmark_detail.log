```python
import pandas as pd
import numpy as np
from devs import Devs, Event

# 시뮬레이션 모델 개요
class SimModel:
    def __init__(self):
        self.collectionTime = "12:00"
        self.days = 30
        self.seeds = 30
        self.leaveSigma = 30.0
        self.wasteSigma = 0.3
        self.threshold = 0.8
        self.capacity = 30.0

    def simulate(self):
        # 거주민 100명, 4개 건물, 건물당 25명
        num_residents = 100
        num_buildings = 4
        residents_per_building = 25

        # 직업: 생산직(일용직, 07:22 출발), 학생(08:58), 전업주부(14:00)
        job_types = ["production", "student", "homemaker"]
        start_time = "07:22"
        end_time = "08:58"
        work_start_time = "14:00"

        # 건물당 30kg 임시 수거통, 수거 차량이 매일 지정 시각에 전체 수거
        collection_capacity = 30  # kg

        # 수거 통 적재율이 임계치(기본 80%) 이상일 때 배출하면 민원 발생으로 집계
        waste_threshold = self.threshold  # (0~1)

        # 시뮬레이션 기간
        simulation_days = self.days

        # 반복 횟수
        repeat_count = self.seeds

        # 수거 시각 표준편차(분)
        leave_std_dev = self.leaveSigma

        # 일일 쓰레기 표준편차(kg)
        waste_std_dev = self.wasteSigma

        # 청결도 임계치(0~1)
        clean_ratio_threshold = self.threshold

        # 수거 통 용량(kg)
        collection_capacity = self.capacity

        # 시뮬레이션 결과
        results = []

        for day in range(simulation_days):
            for building in range(num_buildings):
                for resident in range(residents_per_building):
                    # 일일 쓰레기 양
                    daily_waste = np.random.normal(waste_std_dev, collection_capacity)

                    # 청결도
                    clean_ratio = 1 - (daily_waste / collection_capacity)
                    if clean_ratio < waste_threshold:
                        # 민원 발생
                        results.append({"day": day, "building": building, "resident": resident, "clean_ratio": clean_ratio})
        return pd.DataFrame(results)

# 시뮬레이션 실행
model = SimModel()
results = model.simulate()

print(results)
```

