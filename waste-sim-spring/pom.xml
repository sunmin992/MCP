<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    <groupId>com.wastesim</groupId>
    <artifactId>waste-sim-spring</artifactId>
    <!-- 애플리케이션 버전. 명세서 버전(파일 v1.15 · 문서 2.3)과는 별개 축이라 통일하지 않는다 —
         문서만 고치는 개정과 코드만 고치는 핫픽스가 따로 일어나기 때문이다.
         자세한 근거는 docs/specifications/README.md "버전 체계".
         실행 중인 서버가 어느 명세로 빌드됐는지는 /actuator/info가 둘을 함께 알려준다
         (application.properties의 info.spec.version). -->
    <version>1.1.1</version>
    <packaging>pom</packaging>
    <name>waste-sim-spring</name>
    <description>브로커 MCP 서버와 장량동 시뮬레이터 MCP 서버</description>

    <!-- 명세 §1 의 두 서버를 별개 프로세스로 띄운다. 한 프로세스에 두면 0단계(시뮬레이터 →
         브로커 등록)가 코드 안의 호출로 접히고, 브로커가 시뮬레이터의 클래스를 직접 볼 수
         있어 "능력 카드만 보고 고른다" 는 경계가 지켜지는지 확인할 방법이 없다.
         mcp-common 은 두 서버가 함께 쓰는 도구 계약뿐이다 — 도메인 코드는 넣지 않는다. -->
    <modules>
        <module>mcp-common</module>
        <module>broker</module>
        <module>simulator</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 루트에서 `-pl broker -am spring-boot:run` 처럼 부르면 부모와 mcp-common 도 빌드
             대상에 들어온다. 실행할 main 이 없는 모듈은 건너뛰고, broker · simulator 만 이
             값을 false 로 둔다. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wastesim</groupId>
                <artifactId>mcp-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 테스트 JVM 이 한글 로그를 UTF-8 로 내보내게 한다.
                 Windows 기본 콘솔 인코딩(MS949)으로 찍히면 로그가 깨진다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
