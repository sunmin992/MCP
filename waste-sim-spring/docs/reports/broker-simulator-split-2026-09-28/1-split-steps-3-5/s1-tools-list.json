      "tools": [
        {
          "name": "run_waste_simulation",
          "description": "장량동 원룸촌 생활쓰레기 DEVS 시뮬레이션을 Java 재구현 엔진으로 실행하고 월간 민원 통계를 반환한다.",
          "inputSchema": {
            "type": "object",
            "properties": {
