                "description": "시뮬레이션 기간(일)",
                "default": 30
              },
              "seeds": {
                "type": "integer",
                "description": "반복 횟수",
                "default": 30
              },
              "leaveSigma": {
                "type": "number",
                "description": "외출 시각 표준편차(분)",
                "default": 30.0
              },
              "wasteSigma": {
                "type": "number",
                "description": "일일 배출량 표준편차(kg)",
