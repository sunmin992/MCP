{
  "a": {
    "changing": [
      {
        "name": "민원 수",
        "what_changes": "시뮬레이션 조건(수거 시각, 건물 수, 거주민 구성, 트럭 종류 및 수, 교통 레이어 사용 여부 등)에 따라 월간 총 민원 수와 직업별 민원 수 등이 달라진다",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run()"
      },
      {
        "name": "배출 및 수거된 쓰레기 양",
        "what_changes": "시간(일, 시뮬레이션 기간) 흐름에 따라 거주민 배출 이벤트와 트럭 운행에 의한 수거 이벤트가 발생하며, 이로 인해 적재량과 잔류량 등이 변화한다",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run()"
      },
      {
        "name": "교통 상황에 따른 이동 시간과 민원",
        "what_changes": "시뮬레이션 시작 시 지정된 시간(분)과 경로 방문 순서, 교통 프로파일에 따라 각 구간의 교통 혼잡 가중치가 달라지고, 그에 따라 이동 시간과 교통 관련 민원이 다르게 집계됨",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run(), hopMinutes(), zoneProxyHopMinutes()"
      },
      {
        "name": "잔류 폐기물 분포",
        "what_changes": "시뮬레이션 진행 중 일정 시점마다 잔류 폐기물량이 건물별, 유형별, 트럭별로 집계되고 최종 결과에 반영된다",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run()"
      },
      {
        "name": "수거장 적재 상태 및 용량 초과 민원",
        "what_changes": "시간이 지남에 따라 각 수거장(건물별)에 폐기물이 쌓이고, 임계값을 넘는 경우 민원이 발생하며, 적재 용량 초과 시 일부 또는 미수거로 진단되는 수치들이 변화한다",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run()"
      },
      {
        "name": "트럭 운행별 적재 및 수거 지표",
        "what_changes": "시뮬레이션 기간 동안 각 운행 구간별로 트럭 적재 상황, 수거량, 미수거 발생 횟수 등이 누적되고 결과에 집계됨",
        "evidence": "src/main/java/com/wastesim/simulation/SimulationEngine.java:run(), TripAcc 클래스"
      },
      {
        "name": "시뮬레이션 결과의 월별 쓰레기 배출량",
        "what_changes": "시드별 실험을 통해 월별 배출량 변동과 평균을 계산하며, 월별 쓰레기 배출량 결과에 반영된다",
        "evidence": "src/main/java/com/wastesim/service/ScenarioService.java:monthlyWaste()"
      },
      {
        "name": "차량 종류와 방문 순서에 따른 민원",
        "what_changes": "트럭 종류(기동성, 용량)와 방문 순서(routeSequence)를 바꾸면 이동 시간과 수거 효율이 달라져 민원 발생량도 달라진다",
        "evidence": "src/main/java/com/wastesim/service/ScenarioService.java:truckRouteSearch()"
      }
    ]
  },
