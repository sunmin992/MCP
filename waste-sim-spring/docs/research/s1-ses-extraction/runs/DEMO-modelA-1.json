 "critical_points": [
  {
   "id": "CP-1",
   "where": "민원 판정",
   "must_be": "aspect",
   "why": "세 판정은 '이 중 하나'가 아니라 함께 돌아간다. spec으로 적으면 총 민원 수를 세 판정의 합으로 정의할 수 없다."
  },
  {
   "id": "CP-2",
   "where": "수거지점.민원임계값",
   "must_be": "수거지점의 속성",
   "why": "실험 조건이 아니라 지점이 지니는 성질이고 지점마다 달라야 한다."
  },
  {
   "id": "CP-3",
   "where": "폐기물 유형 집합",
   "must_be": "독립 multi 개체",
   "why": "분리배출 실험에서 유형 수가 변해야 한다. 수거지점의 속성으로 묻으면 구조가 아니라 코드를 고쳐야 한다."
  },
  {
   "id": "CP-4",
   "where": "이동시간 방식 축",
   "must_be": "수거 경로 아래 spec",
   "why": "경로를 어떻게 계산하느냐의 선택이지 차량의 성질이 아니다."
  },
  {
   "id": "CP-5",
   "where": "거주민",
   "must_be": "spec 축 2개 (직업 축, 배출시각 모델 축)",
   "why": "두 축은 곱집합이다. 하나로 합치면 4x2=8 조합을 표현할 수 없고 pruning이 축별 독립 선택으로 떨어지지 않는다."
  }
 ],
