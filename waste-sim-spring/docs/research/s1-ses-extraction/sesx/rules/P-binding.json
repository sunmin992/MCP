{
  "policy_id": "P-binding",
  "experiment_kind": "config_binding",
  "approval_status": "approved",
  "approved_by": "경계 검토자 (정답 파일 목록을 파일 단위로 확인)",
  "frozen_at": "2026-09-21",
  "note": "실행설정 연결 전용. 개체 추출과 목적이 다르므로 경계도 다르다 — 대응의 근거는 선언이 아니라 소비 지점(JangnyangScenarioBuilder.toConfig)이고 그 파일이 정답과 같은 패키지에 있다. 그래서 subtask 패키지를 통째로 열지 않고 파일 단위로 연다. experiment_kind 가 fresh_extraction 이 아니므로 FRESH_BLOCKS 를 타지 않는다. 대신 inventory_globs 를 패키지 전체로 넓혀 두어, 포함 범위를 넓히면 정답이 조용히 들어오지 않고 evaluation_asset_globs 에 걸리게 한다. ALWAYS_EVALUATION_ASSETS(참조 SES·aliases·eval-roles)는 이 정책과 무관하게 코드가 막는다.",

  "inventory_globs": [
    "src/main/java/com/wastesim/**/*.java",
    "src/main/resources/**/*.json",
    "docs/research/s1-ses-extraction/*.json"
  ],

  "include_globs": [
    "src/main/java/com/wastesim/model/SimulationConfig.java",
    "src/main/java/com/wastesim/model/TruckType.java",
    "src/main/java/com/wastesim/model/DischargeTimeMode.java",
    "src/main/java/com/wastesim/model/TravelTimeMode.java",
    "src/main/java/com/wastesim/model/ZoneAssignmentRule.java",
    "src/main/java/com/wastesim/model/OccupationType.java",
    "src/main/java/com/wastesim/model/WasteType.java",
    "src/main/java/com/wastesim/tool/SimulationConfigValidator.java",
    "src/main/java/com/wastesim/tool/ConfigArgs.java",
    "src/main/java/com/wastesim/tool/ErrorCode.java",
    "src/main/java/com/wastesim/tool/ValidationError.java",
    "src/main/java/com/wastesim/registry/SimulationConfigFields.java",
    "src/main/java/com/wastesim/subtask/JangnyangScenarioBuilder.java",
    "src/main/java/com/wastesim/subtask/JangnyangScenarioSpec.java"
  ],

  "exclude_globs": [],
  "exclude_reasons": {},

  "evaluation_asset_globs": [
    "src/main/java/com/wastesim/ses/**",
    "src/main/java/com/wastesim/subtask/JangnyangSubtask.java",
    "src/main/java/com/wastesim/subtask/JangnyangSubtaskCatalog.java",
    "src/main/java/com/wastesim/subtask/JangnyangSubtaskDefinition.java",
    "src/main/java/com/wastesim/subtask/JangnyangSubtaskAnswer.java",
    "src/main/java/com/wastesim/subtask/JangnyangSubtaskValidator.java",
    "src/main/resources/subtask/**",
    "docs/research/s1-ses-extraction/reference-ses*.json",
    "docs/research/s1-ses-extraction/aliases.json",
    "docs/research/s1-ses-extraction/eval-roles.json"
  ],

  "require_classified_roles": true,
  "default_role_for_included": "unclassified",

  "file_roles": [
    {"glob": "src/main/java/com/wastesim/model/SimulationConfig.java",
     "role": "execution_config", "reason": "실행 설정 필드의 선언 자리"},
    {"glob": "src/main/java/com/wastesim/model/*.java",
     "role": "domain_model", "reason": "설정이 가리키는 유형·열거값"},
    {"glob": "src/main/java/com/wastesim/tool/SimulationConfigValidator.java",
     "role": "config_validation", "reason": "설정값의 허용 범위를 검사하는 자리"},
    {"glob": "src/main/java/com/wastesim/tool/*.java",
     "role": "config_validation", "reason": "검사 결과와 오류 코드"},
    {"glob": "src/main/java/com/wastesim/registry/SimulationConfigFields.java",
     "role": "execution_config", "reason": "설정 필드 이름의 선언"},
    {"glob": "src/main/java/com/wastesim/subtask/JangnyangScenarioBuilder.java",
     "role": "config_assembly", "reason": "사용자 입력을 설정으로 옮기는 소비 지점"},
    {"glob": "src/main/java/com/wastesim/subtask/JangnyangScenarioSpec.java",
     "role": "config_assembly", "reason": "입력 필드를 읽어 주는 접근자"}
  ],

  "required_dependencies": {},
  "dependency_waivers": {}
}
