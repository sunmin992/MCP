{
  "policy_id": "P-evidence-v1",
  "experiment_kind": "fresh_extraction",
  "approval_status": "approved",
  "approved_by": "user-authorized source boundary implementation; expert boundary review pending",
  "note": "소스 구조와 실제 import를 기준으로 고정한 초기 경계. 전문가의 의미적 완전성 확인은 별도다.",
  "inventory_globs": ["src/main/java/**/*.java", "src/main/resources/**/*.json"],
  "include_globs": [
    "src/main/java/com/wastesim/simulation/**/*.java",
    "src/main/java/com/wastesim/model/**/*.java",
    "src/main/java/com/wastesim/site/**/*.java",
    "src/main/java/com/wastesim/traffic/**/*.java",
    "src/main/java/com/wastesim/service/TrafficDataService.java",
    "src/main/java/com/wastesim/util/**/*.java",
    "src/main/resources/traffic/**/*.json",
    "src/main/resources/collection/**/*.json",
    "src/main/resources/schedule/**/*.json"
  ],
  "exclude_globs": ["src/main/java/com/wastesim/model/ChatMessage.java"],
  "exclude_reasons": {"src/main/java/com/wastesim/model/ChatMessage.java": "chat transport, not simulation state"},
  "evaluation_asset_globs": ["docs/research/s1-ses-extraction/**", "src/main/java/com/wastesim/ses/**", "src/main/resources/subtask/**"],
  "require_classified_roles": true,
  "default_role_for_included": "unclassified",
  "file_roles": [
    {"glob": "src/main/java/com/wastesim/simulation/**", "role": "simulation_core", "reason": "state updates and simulated time"},
    {"glob": "src/main/java/com/wastesim/model/SimulationConfig.java", "role": "construction", "reason": "configuration and literal defaults"},
    {"glob": "src/main/java/com/wastesim/model/*Result.java", "role": "observation_output", "reason": "result values are not automatically entities"},
    {"glob": "src/main/java/com/wastesim/model/**", "role": "domain_model", "reason": "types, state and characteristics"},
    {"glob": "src/main/java/com/wastesim/site/**", "role": "construction", "reason": "site identity and registration"},
    {"glob": "src/main/java/com/wastesim/traffic/**", "role": "domain_model", "reason": "route and traffic data"},
    {"glob": "src/main/java/com/wastesim/service/TrafficDataService.java", "role": "construction", "reason": "loads data referenced by the engine"},
    {"glob": "src/main/java/com/wastesim/util/**", "role": "support_runtime", "reason": "helper; evidence only"},
    {"glob": "src/main/resources/**", "role": "domain_data", "reason": "configuration resources, not SES declarations"}
  ],
  "check_local_imports": true,
  "required_dependencies": {
    "src/main/java/com/wastesim/site/CollectionSiteRegistry.java": ["src/main/resources/collection/jangnyang-collection-sites.json"]
  },
  "dependency_waivers": {}
}
